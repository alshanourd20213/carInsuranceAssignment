using System;
using System.Web.Mvc;
using InsuranceApp.Models; // Make sure this matches your project's model namespace

namespace InsuranceApp.Controllers
{
    public class InsureeController : Controller
    {
        [HttpPost]
        [ValidateAntiForgeryToken]
        public ActionResult Create(Insuree insuree)
        {
            if (ModelState.IsValid)
            {
                // Safety guard against empty inputs
                string carMake = (insuree.Make ?? "").Trim();
                string carModel = (insuree.Model ?? "").Trim();

                // 1. Base rate
                decimal monthlyTotal = 50m;

                // 2. Age Calculations
                if (insuree.Age <= 18) { monthlyTotal += 100; }
                else if (insuree.Age >= 19 && insuree.Age <= 25) { monthlyTotal += 50; }
                else if (insuree.Age >= 26) { monthlyTotal += 25; }

                // 3. Car Year Calculations
                if (insuree.CarYear < 2000 || insuree.CarYear > 2015) { monthlyTotal += 25; }

                // 4. Make & Model Calculations (Fixed for "Porsche Carrera")
                if (carMake.Equals("Porsche", StringComparison.OrdinalIgnoreCase))
                {
                    monthlyTotal += 25;
                    if (carModel.Equals("Carrera", StringComparison.OrdinalIgnoreCase))
                    {
                        monthlyTotal += 25;
                    }
                }

                // 5. Violations & Coverage
                monthlyTotal += (insuree.SpeedingTickets * 10);
                if (insuree.HasDUI) { monthlyTotal += (monthlyTotal * 0.25m); }
                if (insuree.FullCoverage) { monthlyTotal += (monthlyTotal * 0.50m); }

                // Save final calculation to the object
                insuree.Quote = monthlyTotal;

                // db.Insurees.Add(insuree);
                // db.SaveChanges();
                // return RedirectToAction("Index");
            }
            return View(insuree);
        }
    }
}
